# Slither agent configuration. Install to /etc/slither/agent.yaml.
# Schema: IMPLEMENTATION.md §3.7. Unknown top-level keys are rejected
# with "did you mean?" suggestions.
#
# Any value here can be overridden at runtime with an env var set in the
# systemd unit (see `SLITHER_*` in agent/internal/config/config.go).
# SIGHUP reloads rules + file-collector include/exclude paths only; other
# fields are startup-fixed.

agent:
  host_id_file: /var/lib/slither/host_id
  log_level: info
  # keystore.tpm opts the agent into Phase 6 #118 PCR-bound TPM
  # sealing. Default false → keystore.AutoSelect picks keyring (@u)
  # → file. When true, AutoSelect probes /dev/tpmrm0 + PCR 7 first;
  # probe failure degrades to the same keyring → file chain rather
  # than blocking boot. Operators switching to TPM also pass --tpm
  # to `slither-agent enroll` so the first seal happens against the
  # right PCR state. See docs/install.md §2.2 + ADR-0038.
  keystore:
    tpm: false

collectors:
  process:
    enabled: true
    # Capture an allowlist of loader / interpreter environment variables
    # (LD_PRELOAD, GCONV_PATH, GLIBC_TUNABLES, PYTHONPATH, ...) on exec
    # and expose them to rules as the `EnvVars` Sigma field. Never the
    # full environment — that is where credentials live.
    #
    # Off by default because it costs throughput, not privacy: with it
    # off the exec path reads /proc zero times on a modern kernel, and
    # the environment has no BPF equivalent, so turning it on reinstates
    # one small read per exec. Required by
    # rules/linux/proc-pkexec-suspicious-env.yml (PwnKit / Looney
    # Tunables coverage), which is inert without it.
    capture_env: false
  file:
    enabled: true
    include_paths:
      - /etc/**
      - /usr/bin/**
      - /usr/sbin/**
      - /root/**
      - /home/**
    exclude_paths:
      - /proc/**
      - /sys/**
  net:
    enabled: true
  # Authentication: uprobes on the host's libpam.so.0, so every PAM
  # client — sshd, sudo, su, login, getty, display managers — reports
  # credential checks and session open/close as OCSF Authentication
  # (3002) events. No log parsing, no dependence on auth.log vs
  # journald. Feeds rules/linux/auth-*.yml (SSH root login, SSH
  # password brute force, sudo failure burst).
  #
  # Not seen: rejected SSH public keys (sshd never enters PAM for
  # those) and a libpam inside a container image (a uprobe binds to
  # one inode). Leave libpam_path empty to probe the standard
  # multiarch / lib64 locations; set it only on an unusual layout.
  auth:
    enabled: true
    # libpam_path: /usr/lib/x86_64-linux-gnu/libpam.so.0
  # Kernel activity: module load / unload / rejected load (init_module,
  # finit_module), BPF program load (bpf), kprobe / uprobe attach
  # (perf_event_open). OCSF Kernel Activity (1003). Feeds
  # rules/linux/kmod-*.yml. The agent's own BPF loads and probe
  # attaches are filtered out by pid.
  kernel:
    enabled: true
  # Container lifecycle + context: cgroup create / remove tracepoints
  # give container create and stop for every runtime that names a
  # container's cgroup after its id (docker, containerd / CRI, cri-o,
  # podman, LXC, nspawn), the first exec inside the cgroup gives start,
  # and the cgroup id on every process event fills x_container_id — the
  # `ContainerId` Sigma field on process, file, net, auth and kernel
  # rules. OCSF Container Lifecycle (6000). Needs cgroup v2 for the
  # per-process context. Image pulls and container / image names are
  # runtime state, not kernel state, and are not covered.
  container:
    enabled: true

rules:
  paths:
    - /etc/slither/rules/*.yml

output:
  kind: stdout
